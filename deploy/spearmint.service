[Unit]
Description=Spearmint local management panel

[Service]
Type=exec
WorkingDirectory=%h/.local/opt/spearmint
EnvironmentFile=%h/.config/spearmint/environment
ExecStart=%h/.local/opt/spearmint/.venv/bin/spearmint serve
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
